# ─────────────────────────────────────────────────────────────────────────────
# Environment configuration for the portfolio.
# Copy this file to `.env.local` and fill in the values you want to publish.
# Nothing here is secret in the cryptographic sense, but contact details and the
# optional form endpoint are kept in one place so they are easy to maintain.
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin (used for canonical URLs, sitemap and Open Graph).
# Set this to your production domain, e.g. https://devinenyaenya.dev
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# Contact email shown on the contact page and used by the contact form.
# Leave empty to hide direct email and show a "configure me" note instead.
NEXT_PUBLIC_CONTACT_EMAIL=

# LinkedIn profile URL. Leave empty to hide the LinkedIn link.
# Example: https://www.linkedin.com/in/your-handle
NEXT_PUBLIC_LINKEDIN_URL=

# GitHub profile URL (already configured in src/data/site.ts, override optional).
NEXT_PUBLIC_GITHUB_URL=https://github.com/Nyaenya-Devine

# ── Optional contact form backend ───────────────────────────────────────────
# The contact form works with NO backend: if this is empty it composes a
# mailto: message using NEXT_PUBLIC_CONTACT_EMAIL.
#
# If you set this to a form endpoint (Formspree, Basin, Getform, a Vercel
# Serverless function, etc.), the form POSTs there as JSON instead.
# Choose a provider that supports origin allow-listing and server-side rate
# limiting / spam protection (e.g. Formspree reCAPTCHA/honeypot).
CONTACT_FORM_ENDPOINT=

# Allowed origin for the form endpoint, used by the server action/route if you
# add one. Comma-separated. Kept server-side (no NEXT_PUBLIC prefix).
CONTACT_FORM_ALLOWED_ORIGINS=
